<Window x:Class="ValoLineupViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Valorant Lineup HUD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#D9080B10"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Maximized"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown"
        FontFamily="Segoe UI, Arial">

    <Window.Resources>
        <!-- Custom ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#10141D"/>
            <Setter Property="Width" Value="6"/>
        </Style>

        <!-- Modern Button Style -->
        <Style x:Key="ValoButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A222D"/>
            <Setter Property="Foreground" Value="#ECE8E1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2D3748"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF4655"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="#FF4655"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Red Action Button -->
        <Style x:Key="ValoRedButtonStyle" TargetType="Button" BasedOn="{StaticResource ValoButtonStyle}">
            <Setter Property="Background" Value="#FF4655"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF4655"/>
        </Style>

        <!-- Custom Dark Gaming ComboBox Style -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="22" />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#8A96A6"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#00F0FF"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#00F0FF"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#161E28"/>
            <Setter Property="Foreground" Value="#ECE8E1"/>
            <Setter Property="BorderBrush" Value="#2B3648"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" 
                                          Background="{TemplateBinding Background}" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False" 
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press"
                                          Template="{StaticResource ComboBoxToggleButton}"/>
                            <ContentPresenter Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="10,0,24,0" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left" 
                                              TextBlock.Foreground="#ECE8E1" 
                                              TextBlock.FontWeight="SemiBold"/>
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="300">
                                    <Border Name="DropDownBorder" Background="#121822" BorderBrush="#2A374A" BorderThickness="1" CornerRadius="4" Margin="0,2,0,0">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#ECE8E1"/>
            <Setter Property="Background" Value="#121822"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3" Margin="2,1">
                            <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#253245"/>
                                <Setter Property="Foreground" Value="#00F0FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2D1D28"/>
                                <Setter Property="Foreground" Value="#FF4655"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Khung chính HUD nổi giữa màn hình -->
        <Border Width="1240" Height="780" 
                Background="#0F141C" 
                BorderBrush="#FF4655" 
                BorderThickness="1.5" 
                CornerRadius="10"
                MouseDown="HudContainer_MouseDown">
            
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="0" Opacity="0.8"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Top Bar -->
                    <RowDefinition Height="Auto"/> <!-- Filter Bar -->
                    <RowDefinition Height="*"/>    <!-- Main Split View -->
                    <RowDefinition Height="Auto"/> <!-- Status Footer -->
                </Grid.RowDefinitions>

                <!-- TOP BAR -->
                <Border Grid.Row="0" Background="#161D27" CornerRadius="10,10,0,0" Padding="20,12" BorderBrush="#252F3E" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Logo / Title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#FF4655" CornerRadius="3" Width="6" Height="22" Margin="0,0,12,0"/>
                            <TextBlock Text="VALORANT" Foreground="#FF4655" FontSize="18" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                            <TextBlock Text=" LINEUP COMPANION" Foreground="#ECE8E1" FontSize="18" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            <Border Background="#242E3D" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="OVERLAY HUD" Foreground="#00F0FF" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <!-- Hotkey hints -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="⚡ Phím tắt nhanh: " Foreground="#8A96A6" FontSize="12"/>
                            <Border Background="#253040" CornerRadius="3" Padding="8,2" Margin="4,0">
                                <TextBlock Text="H" Foreground="#00F0FF" FontWeight="Bold" FontSize="12"/>
                            </Border>
                            <TextBlock Text="để Ẩn/Hiện HUD • " Foreground="#8A96A6" FontSize="12" Margin="4,0,0,0"/>
                            <Border Background="#253040" CornerRadius="3" Padding="6,2" Margin="4,0">
                                <TextBlock Text="ESC" Foreground="#FF4655" FontWeight="Bold" FontSize="11"/>
                            </Border>
                            <TextBlock Text="để Đóng" Foreground="#8A96A6" FontSize="12"/>
                        </StackPanel>

                        <!-- Actions -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="+ Thêm Lineup" Style="{StaticResource ValoButtonStyle}" Click="BtnAddLineup_Click" Margin="0,0,10,0"/>
                            <Button Content="✕" Width="34" Height="34" Style="{StaticResource ValoButtonStyle}" Click="BtnClose_Click" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- FILTER BAR -->
                <Border Grid.Row="1" Background="#121721" Padding="20,10" BorderBrush="#252F3E" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/> <!-- Rank Only CheckBox -->
                            <ColumnDefinition Width="Auto"/> <!-- Map -->
                            <ColumnDefinition Width="Auto"/> <!-- Agent -->
                            <ColumnDefinition Width="Auto"/> <!-- Side -->
                            <ColumnDefinition Width="Auto"/> <!-- Site -->
                            <ColumnDefinition Width="*"/>    <!-- Search -->
                        </Grid.ColumnDefinitions>

                        <!-- Filter: Rank Only Checkbox -->
                        <Border Grid.Column="0" Background="#262112" BorderBrush="#FFD700" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,16,0" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkRankOnly" 
                                      Content="🏆 Chỉ Map trong RANK" 
                                      Foreground="#FFD700" FontWeight="Bold" FontSize="12"
                                      VerticalAlignment="Center"
                                      IsChecked="True" 
                                      Checked="FilterChanged" Unchecked="FilterChanged"/>
                        </Border>

                        <!-- Filter: Map -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="Bản đồ:" Foreground="#8A96A6" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                            <ComboBox x:Name="CmbMap" Width="130" SelectionChanged="FilterChanged">
                                <ComboBoxItem Content="Tất cả" IsSelected="True"/>
                                <ComboBoxItem Content="Abyss" FontWeight="Bold" Foreground="#FFD700"/>
                                <ComboBoxItem Content="Sunset" FontWeight="Bold" Foreground="#FFD700"/>
                                <ComboBoxItem Content="Lotus" FontWeight="Bold" Foreground="#FFD700"/>
                                <ComboBoxItem Content="Bind" FontWeight="Bold" Foreground="#FFD700"/>
                                <ComboBoxItem Content="Haven" FontWeight="Bold" Foreground="#FFD700"/>
                                <ComboBoxItem Content="Ascent (Ngoài Rank)" Foreground="#6E7B8B"/>
                                <ComboBoxItem Content="Split (Ngoài Rank)" Foreground="#6E7B8B"/>
                                <ComboBoxItem Content="Icebox" Foreground="#6E7B8B"/>
                                <ComboBoxItem Content="Breeze" Foreground="#6E7B8B"/>
                                <ComboBoxItem Content="Fracture" Foreground="#6E7B8B"/>
                                <ComboBoxItem Content="Pearl" Foreground="#6E7B8B"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Filter: Agent -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="Đặc vụ:" Foreground="#8A96A6" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                            <ComboBox x:Name="CmbAgent" Width="130" SelectionChanged="FilterChanged">
                                <ComboBoxItem Content="Tất cả" IsSelected="True"/>
                                <ComboBoxItem Content="Sova"/>
                                <ComboBoxItem Content="Viper"/>
                                <ComboBoxItem Content="Brimstone"/>
                                <ComboBoxItem Content="Killjoy"/>
                                <ComboBoxItem Content="Fade"/>
                                <ComboBoxItem Content="Gekko"/>
                                <ComboBoxItem Content="Cypher"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Filter: Side -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="Phe:" Foreground="#8A96A6" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                            <ComboBox x:Name="CmbSide" Width="110" SelectionChanged="FilterChanged">
                                <ComboBoxItem Content="Tất cả" IsSelected="True"/>
                                <ComboBoxItem Content="Attacker (Tấn công)"/>
                                <ComboBoxItem Content="Defender (Phòng thủ)"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Filter: Site -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="Khu vực (Site):" Foreground="#8A96A6" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                            <ComboBox x:Name="CmbSite" Width="90" SelectionChanged="FilterChanged">
                                <ComboBoxItem Content="Tất cả" IsSelected="True"/>
                                <ComboBoxItem Content="A"/>
                                <ComboBoxItem Content="B"/>
                                <ComboBoxItem Content="C"/>
                                <ComboBoxItem Content="Mid"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Search Box with Placeholder -->
                        <Grid Grid.Column="5" Height="34" VerticalAlignment="Center">
                            <TextBox x:Name="TxtSearch" Height="34" 
                                     Background="#161E28" Foreground="#ECE8E1" 
                                     BorderBrush="#2B3648" Padding="10,7" 
                                     VerticalAlignment="Center" 
                                     TextChanged="TxtSearch_TextChanged"/>
                            <TextBlock Text="🔍 Tìm kiếm vị trí, đặc vụ..." 
                                       Foreground="#5B6675" FontSize="12"
                                       IsHitTestVisible="False" Margin="10,0,0,0"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <!-- MAIN SPLIT VIEW -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/> <!-- Danh sách Lineup -->
                        <ColumnDefinition Width="*"/>   <!-- Chi tiết Lineup & Hình ảnh căn tâm -->
                    </Grid.ColumnDefinitions>

                    <!-- CỘT TRÁI: DANH SÁCH LINEUP -->
                    <Border Grid.Column="0" Background="#111620" BorderBrush="#252F3E" BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Padding="16,10" Background="#161D27">
                                <TextBlock x:Name="TxtListCount" Text="DANH SÁCH LINEUP (5)" Foreground="#8A96A6" FontSize="11" FontWeight="Bold"/>
                            </Border>

                            <ListBox x:Name="LstLineups" Grid.Row="1" 
                                     Background="Transparent" 
                                     BorderThickness="0" 
                                     SelectionChanged="LstLineups_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="10,6,10,0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder" Background="#161E28" BorderBrush="#263142" BorderThickness="1" CornerRadius="6" Padding="12,10" Cursor="Hand">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#202A38"/>
                                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#00F0FF"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#251F28"/>
                                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FF4655"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <!-- Badges Row -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Border Background="#FF4655" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Agent}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                                <Border Background="#202C3B" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Map}" Foreground="#00F0FF" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                                <Border Background="#2A384A" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Site, StringFormat='Site {0}'}" Foreground="#ECE8E1" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                                <Border Background="#1C2F28" CornerRadius="3" Padding="6,2">
                                                    <TextBlock Text="{Binding Difficulty}" Foreground="#10E7A2" FontSize="10" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Title -->
                                            <TextBlock Text="{Binding Title}" Foreground="#ECE8E1" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <!-- Throw type -->
                                            <TextBlock Text="{Binding ThrowType}" Foreground="#8A96A6" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- CỘT PHẢI: CHI TIẾT VÀ ẢNH HƯỚNG DẪN CĂN TÂM -->
                    <Border Grid.Column="1" Background="#0C1017" Padding="24">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="PnlDetail">
                                <!-- Lineup Header -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border Background="#FF4655" CornerRadius="3" Padding="8,3" Margin="0,0,8,0">
                                                <TextBlock x:Name="BadgeAgent" Text="SOVA" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                            </Border>
                                            <Border Background="#1B2836" CornerRadius="3" Padding="8,3" Margin="0,0,8,0">
                                                <TextBlock x:Name="BadgeMap" Text="ASCENT" Foreground="#00F0FF" FontSize="12" FontWeight="Bold"/>
                                            </Border>
                                            <Border Background="#283546" CornerRadius="3" Padding="8,3">
                                                <TextBlock x:Name="BadgeAbility" Text="Recon Bolt" Foreground="#ECE8E1" FontSize="12" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Background="#260C1A" BorderBrush="#FF0055" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="8,0,0,0">
                                                <TextBlock x:Name="BadgeAuthor" Text="@LineupMaster" Foreground="#FF4D8D" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                            <Border x:Name="BadgeRanked" Background="#2E240D" BorderBrush="#FFD700" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="8,0,0,0">
                                                <TextBlock Text="🏆 IN RANK" Foreground="#FFD700" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock x:Name="TxtDetailTitle" Text="Chọn một Lineup bên trái để xem hướng dẫn" Foreground="#ECE8E1" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Quick Actions -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#212C3B" CornerRadius="4" Padding="12,8" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Kỹ thuật: " Foreground="#8A96A6" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="TxtThrowType" Text="1 Vạch - 1 Nảy" Foreground="#10E7A2" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <Button x:Name="BtnOpenVideo" Content="▶ Xem Clip TikTok" 
                                                Background="#FE2C55" Foreground="White" FontWeight="Bold"
                                                Padding="12,8" BorderThickness="0" Cursor="Hand"
                                                Click="BtnOpenVideo_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 2 Khung ảnh so sánh: VỊ TRÍ ĐỨNG & ĐIỂM CĂN TÂM -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- BƯỚC 1: VỊ TRÍ ĐỨNG -->
                                    <Border Grid.Column="0" Background="#141B26" BorderBrush="#252F3E" BorderThickness="1" CornerRadius="8" Padding="14">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <Border Background="#00F0FF" CornerRadius="3" Width="4" Height="16" Margin="0,0,8,0"/>
                                                <TextBlock Text="BƯỚC 1: VỊ TRÍ ĐỨNG (STAND HERE)" Foreground="#00F0FF" FontWeight="Bold" FontSize="13"/>
                                            </StackPanel>

                                            <!-- Image Box -->
                                            <Border Height="220" Background="#0A0E14" CornerRadius="6" ClipToBounds="True" Margin="0,0,0,10">
                                                <Grid>
                                                    <Image x:Name="ImgStand" Stretch="UniformToFill"/>
                                                    <!-- Placeholder text when image loading fails -->
                                                    <TextBlock x:Name="TxtStandPlaceholder" Text="[Hình ảnh vị trí đứng / góc kẹt chân]" Foreground="#5B6675" HorizontalAlignment="Center" VerticalAlignment="Center" FontStyle="Italic"/>
                                                </Grid>
                                            </Border>

                                            <TextBlock x:Name="TxtStandDesc" Text="Đứng áp sát góc tường bên phải..." Foreground="#C5D1DE" TextWrapping="Wrap" FontSize="13" LineHeight="18"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- BƯỚC 2: ĐIỂM CĂN TÂM NGẮM -->
                                    <Border Grid.Column="2" Background="#141B26" BorderBrush="#252F3E" BorderThickness="1" CornerRadius="8" Padding="14">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <Border Background="#FF4655" CornerRadius="3" Width="4" Height="16" Margin="0,0,8,0"/>
                                                <TextBlock Text="BƯỚC 2: ĐIỂM CĂN TÂM (AIM &amp; HUD)" Foreground="#FF4655" FontWeight="Bold" FontSize="13"/>
                                            </StackPanel>

                                            <!-- Image Box -->
                                            <Border Height="220" Background="#0A0E14" CornerRadius="6" ClipToBounds="True" Margin="0,0,0,10">
                                                <Grid>
                                                    <Image x:Name="ImgAim" Stretch="UniformToFill"/>
                                                    <TextBlock x:Name="TxtAimPlaceholder" Text="[Hình ảnh điểm căn tâm và vạch HUD]" Foreground="#5B6675" HorizontalAlignment="Center" VerticalAlignment="Center" FontStyle="Italic"/>
                                                </Grid>
                                            </Border>

                                            <TextBlock x:Name="TxtAimDesc" Text="Căn vạch thanh sạc HUD khớp với chóp mái..." Foreground="#C5D1DE" TextWrapping="Wrap" FontSize="13" LineHeight="18"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- GHI CHÚ CHIẾN THUẬT / LƯU Ý -->
                                <Border Background="#161E2B" BorderBrush="#2E3C4E" BorderThickness="1" CornerRadius="8" Padding="16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="💡 GHI CHÚ CHIẾN THUẬT (PRO TIPS):" Foreground="#FFD700" FontWeight="Bold" FontSize="13"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtNotes" Text="Lineup này quét toàn bộ Site và Hell mà kẻ địch không thể bắn trả..." Foreground="#ECE8E1" TextWrapping="Wrap" FontSize="13" LineHeight="20"/>
                                    </StackPanel>
                                </Border>
