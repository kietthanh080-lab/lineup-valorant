<Window x:Class="ValoLineupViewer.AddLineupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm Lineup Mới" 
        Height="620" Width="680"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#121824"
        FontFamily="Segoe UI, Arial">

    <Border BorderBrush="#FF4655" BorderThickness="1.5" CornerRadius="8" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="THÊM LINEUP MỚI" Foreground="#FF4655" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Nhập thông tin vị trí căn góc để lưu vào kho cá nhân của bạn" Foreground="#8A96A6" FontSize="12"/>
            </StackPanel>

            <!-- Form Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Map & Agent -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Bản đồ (Map):" Foreground="#ECE8E1" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbAddMap" Height="34">
                                <ComboBoxItem Content="Ascent" IsSelected="True"/>
                                <ComboBoxItem Content="Bind"/>
                                <ComboBoxItem Content="Haven"/>
                                <ComboBoxItem Content="Split"/>
                                <ComboBoxItem Content="Lotus"/>
                                <ComboBoxItem Content="Sunset"/>
                                <ComboBoxItem Content="Breeze"/>
                                <ComboBoxItem Content="Icebox"/>
                                <ComboBoxItem Content="Abyss"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Đặc vụ (Agent):" Foreground="#ECE8E1" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbAddAgent" Height="34">
                                <ComboBoxItem Content="Sova" IsSelected="True"/>
                                <ComboBoxItem Content="Viper"/>
                                <ComboBoxItem Content="Brimstone"/>
                                <ComboBoxItem Content="Killjoy"/>
                                <ComboBoxItem Content="Fade"/>
                                <ComboBoxItem Content="Gekko"/>
                                <ComboBoxItem Content="Cypher"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Side, Site & Ability -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Phe (Side):" Foreground="#ECE8E1" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbAddSide" Height="34">
                                <ComboBoxItem Content="Attacker" IsSelected="True"/>
                                <ComboBoxItem Content="Defender"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Khu vực (Site):" Foreground="#ECE8E1" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbAddSite" Height="34">
                                <ComboBoxItem Content="A" IsSelected="True"/>
                                <ComboBoxItem Content="B"/>
                                <ComboBoxItem Content="C"/>
                                <ComboBoxItem Content="Mid"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Kỹ năng (Ability):" Foreground="#ECE8E1" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtAddAbility" Height="34" Background="#1C2433" Foreground="#ECE8E1" BorderBrush="#2F3E54" Padding="8,6" Text="Recon Bolt"/>
                        </StackPanel>
                    </Grid>

                    <!-- Title -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Tiêu đề Lineup:" Foreground="#ECE8E1" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtAddTitle" Height="34" Background="#1C2433" Foreground="#ECE8E1" BorderBrush="#2F3E54" Padding="8,6"/>
                    </StackPanel>

                    <!-- Throw Type -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Kỹ thuật ném (Throw Type):" Foreground="#ECE8E1" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtAddThrowType" Height="34" Background="#1C2433" Foreground="#ECE8E1" BorderBrush="#2F3E54" Padding="8,6" Text="Đứng bắn (1 vạch - 0 nảy)"/>
                    </StackPanel>

                    <!-- Step 1 Stand Desc & Image -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Mô tả Bước 1: Vị trí đứng:" Foreground="#00F0FF" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtAddStandDesc" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Background="#1C2433" Foreground="#ECE8E1" BorderBrush="#2F3E54" Padding="8,6"/>
                        <TextBlock Text="Đường dẫn ảnh vị trí đứng (URL hoặc file máy tính):" Foreground="#8A96A6" FontSize="11" Margin="0,4,0,2"/>
                        <TextBox x:Name="TxtAddStandImg" Height="30" Background="#1C2433" Foreground="#ECE8E1" BorderBrush="#2F3E54" Padding="6,4"/>
                    </StackPanel>

                    <!-- Step 2 Aim Desc & Image -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Mô tả Bước 2: Điểm căn tâm / vạch HUD:" Foreground="#FF4655" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtAddAimDesc" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Background="#1C2433" Foreground="#ECE8E1" BorderBrush="#2F3E54" Padding="8,6"/>
                        <TextBlock Text="Đường dẫn ảnh điểm căn tâm (URL hoặc file máy tính):" Foreground="#8A96A6" FontSize="11" Margin="0,4,0,2"/>
                        <TextBox x:Name="TxtAddAimImg" Height="30" Background="#1C2433" Foreground="#ECE8E1" BorderBrush="#2F3E54" Padding="6,4"/>
                    </StackPanel>

                    <!-- Notes -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Ghi chú chiến thuật:" Foreground="#FFD700" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtAddNotes" Height="45" TextWrapping="Wrap" AcceptsReturn="True" Background="#1C2433" Foreground="#ECE8E1" BorderBrush="#2F3E54" Padding="8,6"/>
                    </StackPanel>

                    <!-- Video URL -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Link Video TikTok / Shorts (LineupMaster):" Foreground="#FE2C55" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtAddVideoUrl" Height="30" Background="#1C2433" Foreground="#ECE8E1" BorderBrush="#2F3E54" Padding="6,4" Text="https://www.tiktok.com/@lineupmaster"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Hủy bỏ" Width="90" Height="34" Margin="0,0,10,0" Background="#222B38" Foreground="#ECE8E1" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click"/>
                <Button Content="Lưu Lineup" Width="110" Height="34" Background="#FF4655" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
